TELEGRAM_BOT_TOKEN=
# необязательно: без ключа /api/v1/models публичный, ключ нужен только для live-проверки моделей (/ping)
OPENROUTER_API_KEY=
# необязательно (docs/ARCHITECTURE.md → «Запуск бота»); раскомментируйте нужное
# LOOSECHANGE_DATA=data/models.json
# LOOSECHANGE_DATA_URL=https://raw.githubusercontent.com/minuspervy-art/loosechange/main/data/models.json
# LOOSECHANGE_REFRESH_MINUTES=15        # TTL списка моделей (0 — выкл.)
# LOOSECHANGE_FULL_REFRESH_MINUTES=60   # TTL uptime / полного сбора (0 — выкл.)
# LOOSECHANGE_LINK_BASE=https://minuspervy-art.github.io/loosechange   # кнопка «⚡ Установить в один клик»
# LOOSECHANGE_CLI=uvx --from git+https://github.com/minuspervy-art/loosechange loosechange
